<mamelayout version="2">

	<!-- the driver picks the view that matches the Aspect Ratio setting (timecris) -->
	<view name="Standard (4:3)">
		<screen index="0">
			<bounds x="0" y="0" width="4" height="3" />
		</screen>
	</view>

	<view name="Widescreen (16:9)">
		<screen index="0">
			<bounds x="0" y="0" width="16" height="9" />
		</screen>
	</view>

</mamelayout>
